---
// src/pages/index.astro
// Trang chính ứng dụng Tử Vi Đẩu Số AI
// Static output — không có server-side rendering
import "../styles/global.css";
import { AstroApp } from "../components/AstroApp";
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>Tử Vi Đẩu Số AI — Luận Giải Mệnh Bàn Thông Minh</title>
    <meta
      name="description"
      content="Ứng dụng Tử Vi Đẩu Số hiện đại với AI Gemini. Tính toán mệnh bàn chính xác, luận giải sâu sắc theo cả hai trường phái Nam Tông và Bắc Tông. Hoàn toàn miễn phí, bảo mật tuyệt đối."
    />
    <meta
      name="keywords"
      content="tử vi đẩu số, zi wei dou shu, mệnh bàn, chiêm tinh, AI, Gemini"
    />

    <!-- Open Graph -->
    <meta property="og:title" content="Tử Vi Đẩu Số AI" />
    <meta
      property="og:description"
      content="Luận giải mệnh bàn thông minh với AI Gemini"
    />
    <meta property="og:type" content="website" />

    <!-- Content Security Policy — chỉ cho phép giao tiếp với Gemini API -->
    <meta
      http-equiv="Content-Security-Policy"
      content="
        default-src 'self';
        script-src 'self' 'unsafe-inline';
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
        font-src 'self' https://fonts.gstatic.com;
        connect-src 'self' https://generativelanguage.googleapis.com;
        img-src 'self' data:;
        object-src 'none';
        base-uri 'self';
      "
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-ziwei text-white font-sans">
    <!-- Cosmic Star Field (CSS-only, no JS) -->
    <div class="star-field" aria-hidden="true">
      <span style="--dur:2.5s;--delay:0.0s;top:5%;left:12%"></span>
      <span style="--dur:3.2s;--delay:0.5s;top:12%;left:78%"></span>
      <span style="--dur:4.1s;--delay:1.0s;top:22%;left:45%"></span>
      <span style="--dur:2.8s;--delay:1.5s;top:35%;left:92%"></span>
      <span style="--dur:5.0s;--delay:0.2s;top:8%;left:35%"></span>
      <span style="--dur:3.6s;--delay:2.0s;top:55%;left:7%"></span>
      <span style="--dur:2.2s;--delay:0.8s;top:70%;left:60%"></span>
      <span style="--dur:4.5s;--delay:1.2s;top:85%;left:25%"></span>
      <span style="--dur:3.0s;--delay:0.3s;top:42%;left:88%"></span>
      <span style="--dur:2.7s;--delay:1.7s;top:18%;left:62%"></span>
      <span style="--dur:3.8s;--delay:2.5s;top:60%;left:40%"></span>
      <span style="--dur:4.3s;--delay:0.6s;top:78%;left:82%"></span>
      <span style="--dur:2.9s;--delay:1.9s;top:30%;left:18%"></span>
      <span style="--dur:5.2s;--delay:0.4s;top:92%;left:55%"></span>
      <span style="--dur:3.4s;--delay:2.2s;top:48%;left:3%"></span>
      <span
        style="width:3px;height:3px;background:rgba(240,192,64,0.8);--dur:6s;--delay:1.1s;top:15%;left:50%"
      ></span>
      <span
        style="width:3px;height:3px;background:rgba(78,205,196,0.6);--dur:5.5s;--delay:2.8s;top:72%;left:15%"
      ></span>
      <span
        style="width:1px;height:1px;--dur:4.8s;--delay:0.9s;top:38%;left:70%"
      ></span>
      <span
        style="width:1px;height:1px;--dur:3.1s;--delay:3.2s;top:95%;left:42%"
      ></span>
      <span
        style="width:2px;height:2px;background:rgba(124,111,247,0.7);--dur:7s;--delay:1.4s;top:3%;left:85%"
      ></span>
    </div>

    <!-- Bát Quái SVG decorative (fixed, rất mờ) -->
    <svg
      class="bagua-deco"
      style="width:600px;height:600px;top:50%;left:50%;transform:translate(-50%,-50%) rotate(0deg);"
      viewBox="0 0 200 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Vòng ngoài -->
      <circle
        cx="100"
        cy="100"
        r="95"
        stroke="rgba(240,192,64,0.6)"
        stroke-width="0.5"></circle>
      <circle
        cx="100"
        cy="100"
        r="75"
        stroke="rgba(240,192,64,0.4)"
        stroke-width="0.3"></circle>
      <!-- 8 tạc bạch (quẻ tượng trưng) -->
      <line
        x1="100"
        y1="5"
        x2="100"
        y2="195"
        stroke="rgba(240,192,64,0.3)"
        stroke-width="0.3"></line>
      <line
        x1="5"
        y1="100"
        x2="195"
        y2="100"
        stroke="rgba(240,192,64,0.3)"
        stroke-width="0.3"></line>
      <line
        x1="33"
        y1="33"
        x2="167"
        y2="167"
        stroke="rgba(240,192,64,0.2)"
        stroke-width="0.3"></line>
      <line
        x1="167"
        y1="33"
        x2="33"
        y2="167"
        stroke="rgba(240,192,64,0.2)"
        stroke-width="0.3"></line>
      <!-- Âm Dương symbol nhỏ -->
      <circle
        cx="100"
        cy="100"
        r="20"
        fill="none"
        stroke="rgba(240,192,64,0.5)"
        stroke-width="0.5"></circle>
      <path
        d="M100 80 A10 10 0 0 1 100 100 A10 10 0 0 0 100 120 A20 20 0 0 1 100 80Z"
        fill="rgba(240,192,64,0.15)"></path>
    </svg>

    <!-- Vòng trang trí cộng củng thêm -->
    <div
      class="cosmic-ring"
      style="width:800px;height:800px;top:50%;left:50%;margin:-400px 0 0 -400px;"
      aria-hidden="true"
    >
    </div>
    <!-- Header -->
    <header
      class="border-b border-white/10 bg-black/20 backdrop-blur-sm sticky top-0 z-50"
    >
      <div
        class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-3 flex items-center justify-between"
      >
        <div class="flex items-center gap-4">
          <img src="./ziwei_icon.png" alt="Logo" class="w-10 h-10 rounded-xl shadow-lg border border-gold/30 object-cover" />
          <div>
            <h1 class="text-lg font-bold text-gold leading-none tracking-tight">紫微斗數</h1>
            <p class="text-[10px] text-white/40 uppercase tracking-widest mt-1">Tử Vi Đẩu Số AI</p>
          </div>
        </div>

        <nav class="flex items-center gap-4">
          <button
            id="btn-api-settings"
            class="text-xs font-medium text-white/70 hover:text-white transition-all flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 hover:border-gold/30 hover:bg-gold/5"
            aria-label="Cài đặt API Key"
          >
            <span>✨</span>
            <span class="hidden sm:inline">Trợ lý AI</span>
          </button>
          <a
            href="https://aistudio.google.com/apikey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-gold/60 hover:text-gold transition-colors hidden md:block border-l border-white/10 pl-4 h-4 leading-4"
          >
            Lấy API Key →
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main
      class="w-full flex-1 flex flex-col items-center px-6 sm:px-10 md:px-16 lg:px-20 py-8 relative z-10"
    >
      <!-- Hero Section -->
      <section
        id="section-hero"
        class="w-full max-w-7xl flex flex-col items-center py-6 md:py-10"
      >
        <!-- Badge -->
        <div class="flex justify-center mb-10">
          <div
            class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 hover:bg-white/10 transition-colors"
          >
            <span
              class="w-2 h-2 bg-gold rounded-full animate-pulse shadow-[0_0_8px_rgba(240,192,64,0.6)]"
            ></span>

            <span class="text-sm text-white/70 font-medium"
              >Powered by Gemini AI</span
            >
          </div>
        </div>
        <div class="text-center mb-12 px-4">
          <h2
            class="text-5xl sm:text-7xl lg:text-8xl font-bold mb-6 tracking-tight"
          >
            <span
              class="text-gold font-serif-sc"
              style="text-shadow: 0 0 50px rgba(240,192,64,0.35)">紫微斗數</span
            >
          </h2>
          <p
            class="text-xl sm:text-2xl text-white/80 font-light tracking-[0.3em] mb-10 uppercase"
          >
            TỬ VI ĐẨU SỐ AI
          </p>
          <div class="max-w-2xl mx-auto">
            <p class="text-white/50 text-base leading-relaxed text-balance">
              Hệ thống chiêm tinh học đỉnh cao Á Đông — 108 vì sao được an định
              chính xác tuyệt đối bằng thuật toán TypeScript, kết hợp AI Gemini
              3.1 Pro luận giải sâu sắc.
            </p>
          </div>
        </div>
        <!-- Feature badges -->
        <div class="flex flex-wrap justify-center gap-3 mb-16">
          <span
            class="text-xs px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/60 backdrop-blur-md"
            >🔒 Bảo mật — Key chỉ lưu máy bạn</span
          >
          <span
            class="text-xs px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/60 backdrop-blur-md"
            >⚡ Không Backend — 100% Static</span
          >
          <span
            class="text-xs px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/60 backdrop-blur-md"
            >🌐 Miễn phí hoàn toàn</span
          >
        </div>
        <!-- Removed Steps Indicator -->

        <!-- App Container -->
        <div id="ziwei-board-container" class="w-full flex justify-center px-4 mb-20">
          <AstroApp client:load />
        </div>
      </section>
    </main>
    <!-- Footer -->
    <footer
      class="border-t border-white/10 mt-20 pt-12 pb-24 px-6 w-full relative z-10 flex justify-center"
    >
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
        <div
          class="text-white/60 leading-relaxed mb-12 font-light text-[15px] sm:text-[16px]"
        >
          <div
            class="inline-block p-1 px-3 rounded-full bg-gold/10 border border-gold/20 text-gold/90 text-xs font-semibold uppercase tracking-widest mb-8"
          >
            Lời Nhắn Gửi
          </div>
          <div class="flex flex-col items-center w-full mb-12 px-4 sm:px-6">
            <ul class="space-y-6 text-left w-full max-w-2xl list-none">
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Bản chất tham khảo:</strong
                  > Mọi suy luận từ AI sinh ra mang tính chất tham khảo, học thuật
                  và giải trí. AI có thể đưa ra góc nhìn chưa hoàn toàn chuẩn xác
                  do sự đồ sộ của hệ thống chiêm tinh học Á Đông.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Đức năng thắng số:</strong
                  > Tử Vi không phải định mệnh bất di bất dịch. Nếu lá số có nhiều
                  sao cản trở, xin đừng tự ti, bởi sự tu dưỡng tâm tính và nỗ lực
                  chân chính hoàn toàn có thể giúp hóa giải nghịch cảnh.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Tránh chủ quan:</strong
                  > Nếu sở hữu lá số đẹp rạng ngời, không nên vì thế mà chủ quan hay
                  ỷ lại. Thành công bền vững vốn chỉ dành cho những người không ngừng
                  rèn luyện và khiêm nhường.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Thấu hiểu bản ngã:</strong
                  > Hãy xem Tử Vi như một tấm gương soi chiếu, giúp bạn thấu tỏ ưu
                  khuyết điểm của chính mình để từ đó đưa ra những lựa chọn tỉnh thức
                  trong cuộc sống.
                </p>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="mb-12 py-6 px-10 rounded-2xl bg-gradient-to-b from-gold/5 to-transparent border border-gold/10 max-w-xl"
        >
          <p class="text-gold/90 font-serif-sc text-lg mb-2 italic">
            "Vạn dặm hành trình, tâm tĩnh là bình an."
          </p>
          <p class="text-white/50 text-[13px] leading-relaxed">
            Chúc bạn luôn vững tay chèo giữa dòng đời biến động, tìm thấy ánh
            sáng tuệ minh trong từng bước đi, và biến mỗi vì sao trên mệnh bàn
            thành nguồn năng lượng tích cực cho hành trình phía trước.
          </p>
          <div class="mt-4 text-gold/40 text-xl font-light">☸</div>
        </div>
        <div
          class="flex flex-col items-center gap-2 pt-8 border-t border-white/5 w-full max-w-md"
        >
          <p class="text-white/40 text-xs font-medium tracking-wide">
            TỬ VI ĐẨU SỐ AI
          </p>
          <p class="text-white/20 text-[11px] uppercase tracking-tighter">
            Ứng dụng tĩnh · Không backend · Bảo mật tuyệt đối
          </p>
          <p class="text-white/20 text-[11px] uppercase tracking-tighter">
            Dữ liệu 100% nằm trên thiết bị của bạn
          </p>
        </div>
      </div>
    </footer>
    <br />
    <script>
      // Cuộn nhanh xuống khu vực App khi bấm nút Trợ Lý AI
      const btnSettings = document.getElementById("btn-api-settings");
      btnSettings?.addEventListener("click", () => {
        document
          .getElementById("ziwei-board-container")
          ?.scrollIntoView({ behavior: "smooth" });
      });
    </script>
  </body>
</html>
