---
// src/pages/index.astro
// Trang chính ứng dụng Tử Vi Đẩu Số AI
// Static output — không có server-side rendering
import "../styles/global.css";
import { AstroApp } from "../components/AstroApp";
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/tuviai/ziwei_icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>Tử Vi Đẩu Số AI — Luận Giải Mệnh Bàn Thông Minh</title>
    <meta
      name="description"
      content="Ứng dụng Tử Vi Đẩu Số hiện đại với AI Gemini. Tính toán mệnh bàn chính xác, luận giải sâu sắc theo cả hai trường phái Nam Tông và Bắc Tông. Hoàn toàn miễn phí, bảo mật tuyệt đối."
    />
    <meta
      name="keywords"
      content="tử vi đẩu số, zi wei dou shu, mệnh bàn, chiêm tinh, AI, Gemini"
    />

    <!-- Open Graph -->
    <meta property="og:title" content="Tử Vi Đẩu Số AI" />
    <meta
      property="og:description"
      content="Luận giải mệnh bàn thông minh với AI Gemini"
    />
    <meta property="og:type" content="website" />

    <!-- Content Security Policy — chỉ cho phép giao tiếp với Gemini API -->
    <meta
      http-equiv="Content-Security-Policy"
      content="
        default-src 'self';
        script-src 'self' 'unsafe-inline';
        style-src 'self' 'unsafe-inline';
        font-src 'self';
        connect-src 'self' https://generativelanguage.googleapis.com;
        img-src 'self' data:;
        object-src 'none';
        base-uri 'self';
      "
    />
  </head>

  <body class="min-h-screen bg-ziwei text-white font-sans">
    <!-- Cosmic Star Field (CSS-only, no JS) -->
    <div class="star-field" aria-hidden="true">
      <span style="top:5%;left:12%"></span>
      <span style="top:12%;left:78%"></span>
      <span style="top:22%;left:45%"></span>
      <span style="top:35%;left:92%"></span>
      <span style="top:8%;left:35%"></span>
      <span style="top:55%;left:7%"></span>
      <span style="top:70%;left:60%"></span>
      <span style="top:85%;left:25%"></span>
      <span style="top:42%;left:88%"></span>
      <span style="top:18%;left:62%"></span>
      <span style="top:60%;left:40%"></span>
      <span style="top:78%;left:82%"></span>
      <span style="top:30%;left:18%"></span>
      <span style="top:92%;left:55%"></span>
      <span style="top:48%;left:3%"></span>
      <span
        style="width:3px;height:3px;background:rgba(240,192,64,0.8);top:15%;left:50%"
      ></span>
      <span
        style="width:3px;height:3px;background:rgba(78,205,196,0.6);top:72%;left:15%"
      ></span>
      <span
        style="width:1px;height:1px;top:38%;left:70%"
      ></span>
      <span
        style="width:1px;height:1px;top:95%;left:42%"
      ></span>
      <span
        style="width:2px;height:2px;background:rgba(124,111,247,0.7);top:3%;left:85%"
      ></span>
    </div>

    <!-- Bát Quái SVG decorative (fixed, rất mờ) -->
    <svg
      class="bagua-deco"
      style="width:min(72vw,600px);height:min(72vw,600px);top:50%;left:50%;transform:translate(-50%,-50%) rotate(0deg);"
      viewBox="0 0 200 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Vòng ngoài -->
      <circle
        cx="100"
        cy="100"
        r="95"
        stroke="rgba(240,192,64,0.6)"
        stroke-width="0.5"></circle>
      <circle
        cx="100"
        cy="100"
        r="75"
        stroke="rgba(240,192,64,0.4)"
        stroke-width="0.3"></circle>
      <!-- 8 tạc bạch (quẻ tượng trưng) -->
      <line
        x1="100"
        y1="5"
        x2="100"
        y2="195"
        stroke="rgba(240,192,64,0.3)"
        stroke-width="0.3"></line>
      <line
        x1="5"
        y1="100"
        x2="195"
        y2="100"
        stroke="rgba(240,192,64,0.3)"
        stroke-width="0.3"></line>
      <line
        x1="33"
        y1="33"
        x2="167"
        y2="167"
        stroke="rgba(240,192,64,0.2)"
        stroke-width="0.3"></line>
      <line
        x1="167"
        y1="33"
        x2="33"
        y2="167"
        stroke="rgba(240,192,64,0.2)"
        stroke-width="0.3"></line>
      <!-- Âm Dương symbol nhỏ -->
      <circle
        cx="100"
        cy="100"
        r="20"
        fill="none"
        stroke="rgba(240,192,64,0.5)"
        stroke-width="0.5"></circle>
      <path
        d="M100 80 A10 10 0 0 1 100 100 A10 10 0 0 0 100 120 A20 20 0 0 1 100 80Z"
        fill="rgba(240,192,64,0.15)"></path>
    </svg>

    <!-- Vòng trang trí cộng củng thêm -->
    <div
      class="cosmic-ring"
      style="width:min(90vw,820px);height:min(90vw,820px);top:50%;left:50%;transform:translate(-50%,-50%);"
      aria-hidden="true"
    >
    </div>
    <!-- Header -->
    <header class="site-header sticky top-0 z-50">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10 lg:px-14 py-3 flex items-center justify-between gap-4"
      >
        <div class="flex items-center gap-3 sm:gap-4 min-w-0">
          <img
            src="/tuviai/ziwei_icon.png"
            alt="Logo"
            class="w-10 h-10 sm:w-11 sm:h-11 object-cover"
          />
          <div class="min-w-0">
            <h1
              class="text-lg sm:text-xl font-bold text-gold leading-none tracking-[0.14em] font-serif-sc"
            >
              紫微斗數
            </h1>
            <p
              class="text-[10px] sm:text-[11px] text-white/45 uppercase tracking-[0.36em] mt-1 truncate"
            >
              Tử Vi Đẩu Số AI
            </p>
          </div>
        </div>

        <nav class="flex items-center gap-2 sm:gap-4">
          <button
            id="btn-api-settings"
            class="text-xs font-medium text-white/80 hover:text-gold transition-colors flex items-center gap-2 px-3 sm:px-4 py-2 rounded-md border border-white/12 hover:border-gold/30"
            aria-label="Cài đặt API Key"
          >
            <span>✨</span>
            <span class="hidden sm:inline">Trợ lý AI</span>
          </button>
          <a
            href="https://aistudio.google.com/apikey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-gold/75 hover:text-gold transition-colors hidden md:block"
          >
            Lấy API Key →
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main
      class="site-shell w-full flex-1 flex flex-col items-center px-4 sm:px-6 md:px-10 lg:px-16 py-6 sm:py-8 md:py-10 relative z-10"
    >
      <!-- Hero Section -->
      <section
        id="section-hero"
        class="w-full max-w-7xl flex flex-col items-center py-4 md:py-8"
      >
        <div
          class="hero-panel w-full px-5 sm:px-8 md:px-12 lg:px-16 py-8 sm:py-10 md:py-14 mb-10"
        >
          <div class="relative z-10 flex flex-col items-center">
            <div class="flex justify-center mb-6 w-full">
              <div class="hero-badge">
                <span class="w-1.5 h-1.5 bg-gold rounded-full"></span>
                <span class="text-sm font-medium"
                  >Tinh thần thủ công, luận giải bằng Gemini AI</span
                >
              </div>
            </div>

            <div class="text-center mb-8 px-0 sm:px-4 max-w-4xl">
              <div class="section-kicker mb-5">Sương Mây Thiên Cơ</div>
              <h2
                class="text-[clamp(3.2rem,10vw,6.6rem)] font-bold mb-4 leading-none"
              >
                <span
                  class="text-gold font-serif-sc"
                  style="text-shadow: 0 0 26px rgba(214,168,92,0.18)"
                  >紫微斗數</span
                >
              </h2>
              <p
                class="text-sm sm:text-base md:text-lg text-white/75 font-light tracking-[0.22em] mb-6 uppercase"
              >
                TỬ VI ĐẨU SỐ AI
              </p>
              <div class="max-w-3xl mx-auto space-y-4">
                <p
                  class="text-white/70 text-sm sm:text-base md:text-lg leading-relaxed text-balance"
                >
                  Một không gian tra cứu Tử Vi lấy cảm hứng từ tranh vẽ tay,
                  trời chiều và những lớp sương mỏng. Lá số vẫn tính toán hoàn
                  toàn bằng TypeScript, còn phần luận giải được nâng đỡ bởi
                  Gemini theo mô thức BYOK bảo mật.
                </p>
                <p class="text-gold/75 text-[11px] sm:text-xs uppercase tracking-[0.18em]">
                  Made with love by a Yellow Cat
                </p>
              </div>
            </div>

            <!-- Feature badges -->
            <div class="flex flex-wrap justify-center gap-3 w-full max-w-4xl">
              <span class="feature-pill text-xs"
                >🔒 Key chỉ lưu trên thiết bị của bạn</span
              >
              <span class="feature-pill text-xs"
                >🌿 100% Static, không backend</span
              >
              <span class="feature-pill text-xs">🪶 Miễn phí hoàn toàn</span>
            </div>
          </div>
        </div>

        <!-- App Container -->
        <div
          id="ziwei-board-container"
          class="w-full flex justify-center px-0 sm:px-2 mb-16 sm:mb-20"
        >
          <AstroApp client:idle />
        </div>
      </section>
    </main>
    <!-- Footer -->
    <footer
      class="mt-8 sm:mt-12 pb-20 px-4 sm:px-6 w-full relative z-10 flex justify-center"
    >
      <div
        class="footer-panel max-w-5xl w-full mx-auto flex flex-col items-center text-center px-5 sm:px-8 md:px-12 py-10 sm:py-12"
      >
        <div
          class="text-white/70 leading-relaxed mb-10 sm:mb-12 font-light text-[15px] sm:text-[16px]"
        >
          <div class="section-kicker mb-8">Lời Nhắn Gửi</div>
          <div class="flex flex-col items-center w-full mb-12 px-4 sm:px-6">
            <ul class="space-y-6 text-left w-full max-w-2xl list-none">
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Bản chất tham khảo:</strong
                  > Mọi suy luận từ AI sinh ra mang tính chất tham khảo, học thuật
                  và giải trí. AI có thể đưa ra góc nhìn chưa hoàn toàn chuẩn xác
                  do sự đồ sộ của hệ thống chiêm tinh học Á Đông.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Đức năng thắng số:</strong
                  > Tử Vi không phải định mệnh bất di bất dịch. Nếu lá số có nhiều
                  sao cản trở, xin đừng tự ti, bởi sự tu dưỡng tâm tính và nỗ lực
                  chân chính hoàn toàn có thể giúp hóa giải nghịch cảnh.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Tránh chủ quan:</strong
                  > Nếu sở hữu lá số đẹp rạng ngời, không nên vì thế mà chủ quan hay
                  ỷ lại. Thành công bền vững vốn chỉ dành cho những người không ngừng
                  rèn luyện và khiêm nhường.
                </p>
              </li>
              <li class="flex gap-4">
                <span class="text-gold mt-1 text-sm shrink-0">✦</span>
                <p class="text-balance">
                  <strong class="text-gold/80 font-medium"
                    >Thấu hiểu bản ngã:</strong
                  > Hãy xem Tử Vi như một tấm gương soi chiếu, giúp bạn thấu tỏ ưu
                  khuyết điểm của chính mình để từ đó đưa ra những lựa chọn tỉnh thức
                  trong cuộc sống.
                </p>
              </li>
            </ul>
          </div>
        </div>

        <div class="quote-panel mb-12 py-4 px-2 sm:px-6 max-w-xl">
          <p class="text-gold/90 font-serif-sc text-lg mb-2 italic">
            "Vạn dặm hành trình, tâm tĩnh là bình an."
          </p>
          <p class="text-white/50 text-[13px] leading-relaxed">
            Chúc bạn luôn vững tay chèo giữa dòng đời biến động, tìm thấy ánh
            sáng tuệ minh trong từng bước đi, và biến mỗi vì sao trên mệnh bàn
            thành nguồn năng lượng tích cực cho hành trình phía trước.
          </p>
          <div class="mt-4 text-gold/40 text-xl font-light">☸</div>
        </div>
        <div
          class="flex flex-col items-center gap-2 pt-6 w-full max-w-md"
        >
          <p class="text-white/40 text-xs font-medium tracking-wide">
            TỬ VI ĐẨU SỐ AI
          </p>
          <p class="text-white/20 text-[11px] uppercase tracking-tighter">
            Ứng dụng tĩnh · Không backend · Bảo mật tuyệt đối
          </p>
          <p class="text-white/20 text-[11px] uppercase tracking-tighter">
            Dữ liệu 100% nằm trên thiết bị của bạn
          </p>
        </div>
      </div>
    </footer>
    <br />
    <script>
      // Cuộn nhanh xuống khu vực App khi bấm nút Trợ Lý AI
      const btnSettings = document.getElementById("btn-api-settings");
      btnSettings?.addEventListener("click", () => {
        document
          .getElementById("ziwei-board-container")
          ?.scrollIntoView({ behavior: "smooth" });
      });
    </script>
  </body>
</html>
